# FOXY WEEKLY REPORT — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le fichier .env ne doit JAMAIS être commité (ajouté dans .gitignore).

# --- Telegram (optionnel) ---
# Si absent, l'envoi Telegram est simplement ignoré.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (optionnel, V2) ---
# Si absent, le hook Notion est ignoré sans erreur.
NOTION_API_KEY=
NOTION_DATABASE_ID=
